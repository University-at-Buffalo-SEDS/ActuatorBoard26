  "board": {
    "strict_mmio": false,
    "clocks": [],
    "connections": [],
    "pins": [],
    "dma_routes": []
  },
  "traffic": {
    "iterations": 100000,
    "max_payload": 512,
    "queue_depth": 0,
    "immediate_dispatch": true
  },
  "ota": {
    "chunk_size": 512
  },
  "peripherals": [
    {
      "type": "adc",
      "name": "actuation_adc1_fault_injection",
      "model": "stm32_adc",
      "bus": "adc1",
      "bits": 12,
      "channels": 3,
      "channel_samples": [1024, 2048, 3072],
      "noise_lsb": 2,
      "failure_every": 997
    },
    {
      "type": "adc",
      "name": "actuation_adc2",
      "model": "stm32_adc",
      "bus": "adc2",
      "bits": 12,
      "channels": 1,
      "channel_samples": [2048],
      "noise_lsb": 2
    }
  ]
}
