    "delta_size": 24576
  },
  "artifacts": {
    "elf": "build/Release_Script/ActuationBoard.elf",
    "bootloader_elf": "build/Release_Script/ActuationBoardBootloader.elf",
    "firmware": "build/Release_Script/ActuationBoard.launchcore.img",
    "bootloader": "build/Release_Script/ActuationBoardBootloader.bin",
    "factory": "build/Release_Script/ActuationBoard.factory.bin",
    "ota": "build/Release_Script/ActuationBoard.seds"
